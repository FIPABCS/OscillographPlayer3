<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OscillographPlayer.App"
             xmlns:local="using:OscillographPlayer"
             xmlns:fluent="using:AvaloniaFluentUI.Styling"
             xmlns:ui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        
        <fluent:AvaloniaFluentTheme/>

        <Style
            Selector="ui|Card,ui|GroupHeaderCard">
            <Setter Property="Margin" Value="0,1,0,1.5"/>
        </Style>

    </Application.Styles>
</Application>