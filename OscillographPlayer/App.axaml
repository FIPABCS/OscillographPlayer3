<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OscillographPlayer.App"
             xmlns:local="using:OscillographPlayer"
             xmlns:fluent="using:AvaloniaFluentUI.Styling"
             xmlns:ui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        
        <fluent:AvaloniaFluentTheme/>

        <Style
            Selector="ui|SettingCard,
            ui|GroupHeaderCard,
            ui|ExpanderSettingCard:not(ui|GroupHeaderCard > ui|ExpanderSettingCard)">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style
        Selector="ui|SingleDirectionScrollViewer">
        
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>

        </Style>

    </Application.Styles>
</Application>