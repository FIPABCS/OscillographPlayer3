<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             mc:Ignorable="d" 
             MinWidth="450"
             MinHeight="300"
             d:DesignWidth="450"
             d:DesignHeight="600"
             x:Class="OscillographPlayer.Views.SettingsPageVIew">

    <Grid
        RowDefinitions="Auto,*">
    
        <TextBlock
            Grid.Row="0"
            Classes="Title"
            Text="设置"/>

        <ui:SingleDirectionScrollViewer
            Grid.Row="1">
    
            <StackPanel>
                
                <ui:SettingCard
                    Header="语言"
                    Description="该应用程序使用的语言">
                
                    <ComboBox/>
                
                </ui:SettingCard>

                <ui:SettingCard
                    Header="主题"
                    Description="该应用程序的界面主题">
                
                    <ComboBox/>
                
                </ui:SettingCard>

            </StackPanel>

        </ui:SingleDirectionScrollViewer>
    
    </Grid>

</UserControl>
